# =============================================================================
# AgentGuard — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Local Docker — already running)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Direct database connection (via pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_PORT=8002
BACKEND_HOST=0.0.0.0
BACKEND_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8002

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Primary LLM (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# Fallback LLM (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_FALLBACK_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Options: "openai" or "local"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Local embedding model (if EMBEDDING_PROVIDER=local)
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
AGENT_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Redis (for Celery task queue — optional for Phase 1)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
